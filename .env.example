PORT=3003

JWT_SECRET=replace-with-a-long-random-secret

# SSH Key Encryption (for system SSH key management)
# Must be at least 32 characters - can be plain text or hex
SSH_KEY_ENCRYPTION_SECRET=replace-with-a-secure-encryption-secret-min-32-chars

# Database
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# SMTP / Mail server
# SMTP. The transport derives `secure` from the port: 465 = implicit TLS,
# anything else (587) = STARTTLS. There is no SMTP_SECURE variable — setting one
# has no effect. Note the key is SMTP_PASS, not SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookie configuration.
# LEAVE EMPTY. An empty value makes the auth cookies host-only, i.e. bound to the
# exact host that issued them. Setting a dot-prefixed value such as .oraclecloud.vn
# broadcasts them to EVERY subdomain, so any other app or vulnerable host on the
# domain would receive the refresh token. Admin and customer sessions already use
# separate cookie names on separate subdomains and do not need to share a cookie.
COOKIE_DOMAIN=
NODE_ENV=production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://example.com/api/auth/google/callback
FRONTEND_URL=https://example.com
# Admin frontend URL (when user logs in as admin through Google OAuth)
FRONTEND_URL_ADMIN=https://admin.example.com

# Sepay webhook (signed bank transaction notifications)
SEPAY_WEBHOOK_API_KEY=

# Bank account shown on the payment QR / instructions screen
BANK_ACCOUNT_NUMBER=
BANK_NAME=

# Admin login-history geolocation (IP -> country/city fallback).
# Used only when the browser did not share coordinates; coordinates always win.
# Replaces the bundled geoip-lite GeoLite2 database, which cost ~145 MB RSS at
# boot to enrich a handful of rows per month.
#   - {ip} is substituted with the (validated) client address
#   - set to an empty value to disable IP lookups entirely
GEOIP_LOOKUP_URL=https://ipwho.is/{ip}
GEOIP_LOOKUP_TIMEOUT_MS=2000
